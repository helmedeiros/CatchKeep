{
  "name": "catchkeep-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest run",
    "check": "npm run api:check && npm run typecheck && npm run lint && npm run test",
    "preview": "vite preview",
    "api:generate": "openapi-typescript ../api/openapi.yaml -o src/api/schema.gen.ts",
    "api:check": "openapi-typescript ../api/openapi.yaml -o src/api/schema.gen.ts --check"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-virtuoso": "4.18.23",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.93.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
