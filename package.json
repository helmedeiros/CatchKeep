{
  "name": "catchkeep",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted web app that recommends which Pokémon GO Pokémon to keep or transfer to reach a storage target.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "check": "npm run format:check && npm run lint:md && npm run lint:sh",
    "prepare": "husky",
    "lint:sh": "shellcheck scripts/*.sh && shellcheck -s sh .husky/pre-commit .husky/commit-msg"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "markdownlint-cli2": "0.24.1",
    "prettier": "3.10.1"
  }
}
